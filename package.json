{
  "name": "netflix-home",
  "version": "1.0.0",
  "private": true,
  "description": "A Netflix-style streaming UI for a local movie library.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "bundle": "node bundle/build.mjs",
    "deploy": "node bundle/build.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
